{
    "cleanUrls": false,
    "trailingSlash": true,
    "rewrites": [
        {
            "source": "/docs",
            "destination": "/docs/index.html"
        },
        {
            "source": "/docs/:dir([a-z0-9-]+)",
            "destination": "/docs/:dir/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/docs/:dir([a-z0-9-]+)/:page([a-z0-9-]+)",
            "destination": "/docs/:dir/:page.html",
            "type": 301
        }
    ]
}
