{
    "cleanUrls": false,
    "trailingSlash": true,
    "rewrites": [
        {
            "source": "/",
            "destination": "/index.html"
        },
        {
            "source": "/:dir([a-z0-9-]+)",
            "destination": "/:dir/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/:dir([a-z0-9-]+)/:page([a-z0-9-]+)",
            "destination": "/:dir/:page.html",
            "type": 301
        }
    ]
}
